{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ezquake",
  "version": "1.0.0",
  "dependencies": [
    { "name": "pkgconf", "default-features": false, "platform": "osx", "host": true },
    { "name": "zlib", "default-features": false },
    { "name": "pcre2", "default-features": false },
    { "name": "minizip", "default-features": false },
    { "name": "curl", "default-features": false, "features": ["ssl"], "platform": "windows" },
    { "name": "curl", "default-features": false, "features": ["mbedtls"], "platform": "linux, osx" }
  ],
  "default-features": ["client"],
  "features": {
    "client": {
      "description": "Dependencies for the graphical client",
      "dependencies": [
        { "name": "expat", "default-features": false },
        { "name": "jansson", "default-features": false },
        { "name": "libpng", "default-features": false },
        { "name": "libjpeg-turbo", "default-features": false },
        { "name": "freetype", "default-features": false, "features": ["zlib"] },
        { "name": "opus", "default-features": false },
        { "name": "speex", "default-features": false },
        { "name": "speexdsp", "default-features": false },
        { "name": "libsndfile", "default-features": false, "features": ["external-libs"] },
        { "name": "alsa", "default-features": false, "platform": "linux" },
        { "name": "sdl2", "default-features": false, "platform": "windows, osx" },
        { "name": "sdl2", "default-features": false, "features": ["wayland", "x11", "alsa"], "platform": "linux" }
      ]
    }
  }
}
