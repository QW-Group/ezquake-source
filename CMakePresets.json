            "name": "windows-asan",
            "inherits": "template-asan-test",
            "configurePreset": "windows-asan",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "macos-asan",
            "inherits": "template-asan-test",
            "configurePreset": "macos-asan",
            "configuration": "Debug"
        }
